{
  "name": "chidozie-nnachor-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Chidozie Nnachor's static software engineering portfolio",
  "author": "Chidozie Nnachor",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "outlook": "node scripts/backlog-outlook.mjs",
    "outlook:update": "node scripts/backlog-outlook.mjs --write",
    "outlook:check": "node scripts/backlog-outlook.mjs --check",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "check:static": "node scripts/build-static.mjs --check && node tests/static-site.test.mjs",
    "dev": "npm run build:static && npm run preview:static",
    "build": "npm run build:static",
    "start": "npm run preview:static",
    "test": "npm run check:static"
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "11.19.1"
  }
}
